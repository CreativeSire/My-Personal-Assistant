# Victor-OS Environment Template
# Copy to `.env` and fill in values.
# Run `python victor_setup.py` for an interactive wizard instead.
# Do NOT commit your real `.env` to version control.

# ═══════════════════════════════════════════════════════════════
# CORE
# ═══════════════════════════════════════════════════════════════
APP_ENV=prod

# Who owns this instance — used as the canonical user_id in memory and sessions.
# Change this to your preferred identifier (no spaces).
VICTOR_OWNER_USER_ID=ceejay

# ═══════════════════════════════════════════════════════════════
# AI API KEYS (at least one required)
# ═══════════════════════════════════════════════════════════════
# Primary AI: Google Gemini
GOOGLE_API_KEY=
GEMINI_API_KEY=          # Alias — falls back to GOOGLE_API_KEY if blank

# For self-coder skill: Claude AI (optional)
ANTHROPIC_API_KEY=

# ═══════════════════════════════════════════════════════════════
# TELEGRAM (required)
# ═══════════════════════════════════════════════════════════════
TELEGRAM_BOT_TOKEN=
# Your personal Telegram user ID (get it from @userinfobot)
TELEGRAM_TARGET_ID=

# ═══════════════════════════════════════════════════════════════
# EMAIL (optional — enables email_intelligence skill)
# ═══════════════════════════════════════════════════════════════
EMAIL_USER=
EMAIL_PASS=
TO_EMAIL=
# IMAP/SMTP host (default: Gmail)
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587

# ═══════════════════════════════════════════════════════════════
# MEMORY & ENCRYPTION
# ═══════════════════════════════════════════════════════════════
MEMORY_V3_ENABLED=true
# Fernet key for encrypting memory. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
VICTOR_MEMORY_KEY=

# ═══════════════════════════════════════════════════════════════
# PROACTIVE ENGINE & ALERTING
# ═══════════════════════════════════════════════════════════════
PROACTIVE_ENABLED=true
PROACTIVE_TELEGRAM_ENABLED=true
PROACTIVE_EMAIL_ENABLED=false
PROACTIVE_POLL_SECONDS=300
PROACTIVE_SEVERITY_MODE=warning_and_above
# Thresholds for system alerts
CRITICAL_RAM_THRESHOLD=95
CRITICAL_DISK_THRESHOLD=95
CRITICAL_QUEUE_DEPTH_THRESHOLD=20
CRITICAL_CONSECUTIVE_FAILURES=3
DAILY_BRIEFING_BOOT_RUN=true

# ═══════════════════════════════════════════════════════════════
# MARKET WATCH
# ═══════════════════════════════════════════════════════════════
MARKET_WATCH_SYMBOLS=BTC,ETH,SOL,BNB,AAPL,TSLA,NVDA,USD/NGN
MARKET_WATCH_MOVE_THRESHOLD=1.5

# ═══════════════════════════════════════════════════════════════
# INVOICE PIPELINE
# ═══════════════════════════════════════════════════════════════
INVOICE_JOB_ENABLED=true
INVOICE_MODE=production
INVOICE_ALLOWED_EXTS=png,jpg,jpeg,pdf,tif,tiff,bmp,webp,heic
# Path to golden test ZIP (optional — for testing only)
GOLDEN_INPUT_PATH=
GOLDEN_IMAGES_ONLY=true

# ═══════════════════════════════════════════════════════════════
# CRITIC / QUALITY CONTROL
# ═══════════════════════════════════════════════════════════════
CRITIC_ENABLED=true
CRITIC_SCORE_THRESHOLD=6

# ═══════════════════════════════════════════════════════════════
# SELF-TRAINING
# ═══════════════════════════════════════════════════════════════
SELF_TRAINING_ENABLED=true
SELF_TRAINING_MIN_EXAMPLES=50
SELF_TRAINING_GOLDEN_CONTEXT_K=20
GEMINI_TUNING_ENABLED=false
GEMINI_TUNING_MIN_EXAMPLES=500

# ═══════════════════════════════════════════════════════════════
# LOCAL INFERENCE ROUTER
# ═══════════════════════════════════════════════════════════════
LOCAL_ROUTER_THRESHOLD=0.7
LOCAL_ROUTER_ALLOWED_CLASSES=ops_status,filesystem_routine,invoice_routine
LOCAL_ROUTER_MODEL_PATH=memory_store/intent_classifier.pkl

# ═══════════════════════════════════════════════════════════════
# GOALS AUTO-DETECT
# ═══════════════════════════════════════════════════════════════
GOALS_AUTO_DETECT=true

# ═══════════════════════════════════════════════════════════════
# VOICE (disabled by default — requires Picovoice + PyAudio)
# ═══════════════════════════════════════════════════════════════
VOICE_ENABLED=false
# Get free key at https://console.picovoice.ai/
PORCUPINE_ACCESS_KEY=
WAKE_WORD=jarvis

# ═══════════════════════════════════════════════════════════════
# FILE WATCHER (monitors a folder and auto-ingests files)
# ═══════════════════════════════════════════════════════════════
FILE_WATCHER_ENABLED=false
# Create this folder — anything dropped here gets processed automatically
FILE_WATCHER_INBOX=C:\Users\HomePC\Desktop\Victor_Inbox

# ═══════════════════════════════════════════════════════════════
# FILE BRIDGE (for running on your local PC, pushing to remote EC2)
# Set these when running file_bridge.py on a local machine
# ═══════════════════════════════════════════════════════════════
# URL of your Victor instance (local or EC2)
VICTOR_API_URL=http://127.0.0.1:8787
# Which local folders to watch (comma-separated)
BRIDGE_WATCH_DIRS=
BRIDGE_POLL_SECONDS=30
BRIDGE_EXTENSIONS=pdf,docx,txt,md,jpg,jpeg,png,mp3,wav,m4a,zip

# ═══════════════════════════════════════════════════════════════
# GOOGLE CALENDAR (disabled until credentials provided)
# ═══════════════════════════════════════════════════════════════
# 1. Enable Calendar API at https://console.cloud.google.com/
# 2. Create OAuth2 credentials (Desktop App), download credentials.json
# 3. Run: python -c "from skills.calendar_sync import auth; auth()"
GOOGLE_CALENDAR_CREDENTIALS=memory_store/google_credentials.json
GOOGLE_CALENDAR_TOKEN=memory_store/google_calendar_token.json
GOOGLE_CALENDAR_ID=primary

# ═══════════════════════════════════════════════════════════════
# BROWSER AGENT (disabled by default — requires Playwright)
# ═══════════════════════════════════════════════════════════════
BROWSER_AGENT_ENABLED=false
BROWSER_COOKIE_STORE=memory_store/browser_sessions

# ═══════════════════════════════════════════════════════════════
# SELF-CODER (disabled by default)
# Enables Victor to write and deploy its own skill files via Claude API
# ═══════════════════════════════════════════════════════════════
SELF_CODER_ENABLED=false
SELF_CODER_WORKSPACE=workspace/proposed_changes

# ═══════════════════════════════════════════════════════════════
# WHATSAPP / TWILIO (disabled by default)
# ═══════════════════════════════════════════════════════════════
WHATSAPP_ENABLED=false
WHATSAPP_PORT=5000
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+1XXXXXXXXXX
WHATSAPP_FALLBACK_INMEMORY=false

# ═══════════════════════════════════════════════════════════════
# WEBHOOK RECEIVER (for Stripe, GitHub, Shopify, etc.)
# ═══════════════════════════════════════════════════════════════
WEBHOOK_ENABLED=false
WEBHOOK_PORT=7878
STRIPE_WEBHOOK_SECRET=
GITHUB_WEBHOOK_SECRET=
SHOPIFY_WEBHOOK_SECRET=

# ═══════════════════════════════════════════════════════════════
# VICTOR API (internal control plane)
# ═══════════════════════════════════════════════════════════════
VICTOR_TASK_API_URL=http://127.0.0.1:8787
# API key for authenticating requests to Victor's REST API
VICTOR_API_KEY=

# ═══════════════════════════════════════════════════════════════
# MULTI-USER (optional)
# JSON list of {telegram_id, name, role} objects.
# Roles: owner | trusted | viewer
# ═══════════════════════════════════════════════════════════════
VICTOR_AUTHORIZED_USERS=[]

# ═══════════════════════════════════════════════════════════════
# EC2 / PRODUCTION SETTINGS
# (Only needed when deployed to EC2 — not required for local dev)
# ═══════════════════════════════════════════════════════════════
# Your EC2 public domain (after Nginx + SSL setup)
VICTOR_PUBLIC_URL=https://victor.yourdomain.com

# S3 bucket for automated backups (configured by deploy_ec2.sh)
S3_BACKUP_BUCKET=

# ═══════════════════════════════════════════════════════════════
# TASK HANDLER TIMEOUT
# ═══════════════════════════════════════════════════════════════
TASK_HANDLER_TIMEOUT_SEC=300

# ═══════════════════════════════════════════════════════════════
# TELEGRAM UPLOAD LIMITS
# ═══════════════════════════════════════════════════════════════
TELEGRAM_MAX_DOC_MB=45
