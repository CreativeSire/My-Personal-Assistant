{
  "version": "1.0.0",
  "description": "Canonical 43-field invoice extraction schema for Victor-OS",
  "fields": [
    { "name": "delivery_date", "type": "string", "required": true },
    { "name": "receiver_name", "type": "string", "required": true },
    { "name": "receiver_location", "type": "string", "required": true },
    { "name": "receiver_outlet", "type": "string", "required": false },
    { "name": "invoice_number", "type": "string", "required": true },
    { "name": "invoice_date", "type": "string", "required": false },
    { "name": "due_date", "type": "string", "required": false },
    { "name": "seller_name", "type": "string", "required": false },
    { "name": "seller_address", "type": "string", "required": false },
    { "name": "seller_phone", "type": "string", "required": false },
    { "name": "seller_email", "type": "string", "required": false },
    { "name": "seller_tax_id", "type": "string", "required": false },
    { "name": "buyer_name", "type": "string", "required": false },
    { "name": "buyer_address", "type": "string", "required": false },
    { "name": "buyer_phone", "type": "string", "required": false },
    { "name": "buyer_email", "type": "string", "required": false },
    { "name": "payment_terms", "type": "string", "required": false },
    { "name": "payment_method", "type": "string", "required": false },
    { "name": "currency", "type": "string", "required": false },
    { "name": "subtotal", "type": "number", "required": false },
    { "name": "discount", "type": "number", "required": false },
    { "name": "tax_amount", "type": "number", "required": false },
    { "name": "total_amount", "type": "number", "required": false },
    { "name": "amount_paid", "type": "number", "required": false },
    { "name": "balance_due", "type": "number", "required": false },
    { "name": "purchase_order_number", "type": "string", "required": false },
    { "name": "reference_number", "type": "string", "required": false },
    { "name": "waybill_number", "type": "string", "required": false },
    { "name": "driver_name", "type": "string", "required": false },
    { "name": "vehicle_number", "type": "string", "required": false },
    { "name": "route_name", "type": "string", "required": false },
    { "name": "dispatch_date", "type": "string", "required": false },
    { "name": "delivery_window", "type": "string", "required": false },
    { "name": "item_count", "type": "integer", "required": false },
    { "name": "quantity_total", "type": "number", "required": false },
    { "name": "notes", "type": "string", "required": false },
    { "name": "document_type", "type": "string", "required": false },
    { "name": "page_count", "type": "integer", "required": false },
    { "name": "language", "type": "string", "required": false },
    { "name": "ocr_engine", "type": "string", "required": false },
    { "name": "ocr_text_present", "type": "boolean", "required": true },
    { "name": "confidence_score", "type": "number", "required": true },
    { "name": "_extractor_model_used", "type": "string", "required": true }
  ]
}
